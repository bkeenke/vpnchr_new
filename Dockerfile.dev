# Dev-окружение как в shm-client-2: next dev с исходниками из томов + nginx перед ним.

# Базовый образ Node можно подменить: NODE_IMAGE=node:22-alpine docker compose … (нужен Node ≥ 20.9)
ARG NODE_IMAGE=node:24-alpine

FROM ${NODE_IMAGE} AS node
WORKDIR /app
# Сбрасываем ENTRYPOINT базового образа, если он задан
ENTRYPOINT []
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund
# Конфиги сборки; src/ и public/ подключаются томами в docker-compose.dev.yml
COPY next.config.ts tsconfig.json postcss.config.mjs eslint.config.mjs ./
EXPOSE 3000
CMD ["npx", "next", "dev", "--hostname", "0.0.0.0", "--port", "3000"]

FROM nginx:stable-alpine AS nginx
COPY docker/nginx.dev.conf /etc/nginx/conf.d/default.conf
HEALTHCHECK --interval=10s --timeout=5s --retries=3 CMD wget -q --spider http://127.0.0.1/healthcheck || exit 1
EXPOSE 80
